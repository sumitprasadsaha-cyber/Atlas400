rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. MASTER GATE: Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. REUSABLE HELPERS
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "Admin"])
      );
    }

    function isAssociatedStudent(studentId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId == studentId;
    }

    // 3. SCHEMA VALIDATION PREDICATES

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ["admin", "student", "Admin", "Student"] &&
             (!('isActive' in data) || data.isActive is bool) &&
             (!('displayName' in data) || data.displayName is string) &&
             (!('photoURL' in data) || data.photoURL == null || data.photoURL is string);
    }

    function isValidStudent(data) {
      return data.studentId is string && data.studentId.size() <= 128 &&
             data.fullName is string && data.fullName.size() <= 128 &&
             data.phone is string && data.phone.size() <= 32 &&
             data.email is string && data.email.size() <= 256 &&
             data.batch is string && data.batch.size() <= 64 &&
             data.status in ["active", "inactive"] &&
             data.serviceStatus in ["active", "paused", "ended"];
    }

    function isValidAdmin(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.name is string && data.name.size() <= 128 &&
             data.permissions is list;
    }

    function isValidSettings(data) {
      return data.appVersion is string &&
             data.maintenanceMode is bool &&
             data.minimumSupportedVersion is string;
    }

    function isValidAppConfig(data) {
      return data.storageBackend in ["r2", "local", "firebase"] &&
             data.aiProvider is string &&
             data.maxUploadSize is number &&
             data.allowedFileTypes is list &&
             data.featureFlags is map;
    }

    function isValidAuditLog(data) {
      return data.timestamp is string &&
             data.userId is string &&
             data.role is string &&
             data.action is string &&
             data.resource is string &&
             data.status in ["success", "failure", "warning"];
    }

    // 4. COLLECTION MATCH RULES

    // USERS COLLECTION
    // Users can read their own profile; Admins can read all.
    // Users can create/update their own non-privileged details; Admins can manage all.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && (
        (isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.uid == userId) ||
        isAdmin()
      );
      allow update: if (isAdmin() && isValidUser(request.resource.data)) ||
                      (isOwner(userId) && isValidUser(request.resource.data) &&
                       request.resource.data.uid == userId &&
                       request.resource.data.role == resource.data.role); // Students cannot elevate own role
      allow delete: if isAdmin();
    }

    // STUDENTS COLLECTION
    // Admins can perform full CRUD.
    // Students can read only their own associated student profile.
    match /students/{studentId} {
      allow read: if isAdmin() || isAssociatedStudent(studentId);
      allow create, delete: if isAdmin() && isValidStudent(request.resource.data);
      allow update: if (isAdmin() && isValidStudent(request.resource.data)) ||
                      (isAssociatedStudent(studentId) && isValidStudent(request.resource.data) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profilePhoto', 'phone', 'guardian', 'updatedAt']));
    }

    // ADMINS COLLECTION
    // Only verified Admins can read, create, update, delete.
    match /admins/{adminId} {
      allow read, write: if isAdmin() && (request.resource == null || isValidAdmin(request.resource.data));
    }

    // SETTINGS COLLECTION
    // All authenticated users can read global settings; only Admins can write.
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && (request.resource == null || isValidSettings(request.resource.data));
    }

    // APP_CONFIG COLLECTION
    // All authenticated users can read app config; only Admins can write.
    match /app_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && (request.resource == null || isValidAppConfig(request.resource.data));
    }

    // AUDIT_LOGS COLLECTION
    // Authenticated users can append audit logs (create); Only Admins can read. No one can update or delete.
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidAuditLog(request.resource.data);
      allow update, delete: if false; // Immutable audit log trail
    }
  }
}
